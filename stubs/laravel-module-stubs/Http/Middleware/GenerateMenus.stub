<?php

namespace {{namespace}}\{{moduleName}}\Http\Middleware;

use Closure;

class GenerateMenus
{
    /**
     * Handle an incoming request.
     *
     * @param  \Illuminate\Http\Request  $request
     * @param  \Closure  $next
     * @return mixed
     */
    public function handle($request, Closure $next)
    {
        /*
         *
         * Module Menu for Admin Backend
         *
         * *********************************************************************
         */
        \Menu::make('admin_sidebar', function ($menu) {

            // {{moduleNamePlural}}
            $menu->add('<i class="c-sidebar-nav-icon cil-plus"></i> '.__('{{moduleName}}'), [
                'route' => 'backend.{{moduleNameLower}}.index',
                'class' => 'c-sidebar-nav-item',
            ])
            ->data([
                'order'         => 77,
                'activematches' => ['admin/{{moduleNameLower}}*'],
                'permission'    => ['view_{{moduleNameLower}}'],
            ])
            ->link->attr([
                'class' => 'c-sidebar-nav-link',
            ]);
        })->sortBy('order');



        return $next($request);
    }
}
